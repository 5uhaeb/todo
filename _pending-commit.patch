+            <p>{error}</p>
+          </>
+        ) : (
+          <>
+            <h2 style={{ marginBottom: 8 }}>Signing you in…</h2>
+            <p>Hang tight, finishing up.</p>
+          </>
+        )}
+      </div>
+    </div>
+  );
+}
